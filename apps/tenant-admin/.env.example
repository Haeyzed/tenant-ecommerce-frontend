# tenant-admin environment (spec §37). Copy to .env.local for development.

APP_ENV=local

# Must equal the backend PLATFORM_ROOT_DOMAIN. Staff reach a store at {slug}.admin.{ROOT_DOMAIN}.
ROOT_DOMAIN=tenant-ecommerce-api.test

# Laravel's private address. The BFF sends the tenant Host header itself.
# With Laravel Herd, nginx on port 80 serves every *.tenant-ecommerce-api.test host.
LARAVEL_INTERNAL_URL=http://127.0.0.1

# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# The previous key, accepted for decryption during rotation.
SESSION_SECRET_PREVIOUS=

# Fallback token lifetime when a login response has no expires_at (minutes).
SANCTUM_TTL_MINUTES=720

# Local development without the edge (spec §38.6): plain-http cookies and a
# fixed store on http://localhost:3001. Both are refused in production.
INSECURE_COOKIES=true
DEV_TENANT_SLUG=
# Local: open any store at http://{slug}.admin.localhost:3001 (browsers resolve *.localhost locally).
DEV_ADMIN_HOST=admin.localhost

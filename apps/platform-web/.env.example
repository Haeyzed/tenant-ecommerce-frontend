# platform-web environment (spec §37). Copy to .env.local for development.
# The website holds no session, so it has no session secret.

APP_ENV=local

# Must equal the backend PLATFORM_ROOT_DOMAIN. The website always calls the landlord host.
ROOT_DOMAIN=tenant-ecommerce-api.test

# Laravel's private address. With Laravel Herd, nginx on port 80 serves the root domain.
LARAVEL_INTERNAL_URL=http://127.0.0.1

# Where a new store's admin lives; {slug} is replaced with the store's slug.
# Production: https://{slug}.admin.example.com. Local: tenant-admin with DEV_ADMIN_HOST=admin.localhost.
TENANT_ADMIN_URL=http://{slug}.admin.localhost:3001

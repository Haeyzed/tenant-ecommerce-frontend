# platform-admin environment (spec §37). Copy to .env.local for development.

APP_ENV=local

# Must equal the backend PLATFORM_ROOT_DOMAIN. The console always calls the landlord host.
ROOT_DOMAIN=tenant-ecommerce-api.test

# Laravel's private address. With Laravel Herd, nginx on port 80 serves the root domain.
LARAVEL_INTERNAL_URL=http://127.0.0.1

# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=

# Fallback token lifetime when a login response has no expires_at (minutes).
SANCTUM_TTL_MINUTES=720

# Plain-http local development only (cookies without the __Host- prefix). Refused in production.
INSECURE_COOKIES=true